# Placeholder — style rules enforced by `dotnet format` + analyzers (roadmap step 1-2).
# Fill in the C#/.NET conventions when the first project lands.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4

[*.{json,yml,yaml,props,targets,csproj}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
