<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <PackageId>Act.App</PackageId>
    <ElectronSingleInstance>true</ElectronSingleInstance>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ElectronPackaging)' != 'true'">
    <RuntimeIdentifier></RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ElectronNET.Core" />
    <PackageReference Include="ElectronNET.Core.AspNet" />
    <PackageReference Include="Microsoft.CodeAnalysis.ResxSourceGenerator" PrivateAssets="all" />
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="icon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Seeding\**" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Resources\Strings.resx" GenerateSource="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Act.Agents.ClaudeCode\Act.Agents.ClaudeCode.csproj" />
    <ProjectReference Include="..\Act.Agents.Codex\Act.Agents.Codex.csproj" />
    <ProjectReference Include="..\Act.Core\Act.Core.csproj" />
    <ProjectReference Include="..\Act.Infrastructure\Act.Infrastructure.csproj" />
  </ItemGroup>

</Project>
