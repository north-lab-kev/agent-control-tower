@page "/archive"
@using Act.Core.Model
@using Act.Core.Rules

<PageTitle>@Strings.Archive_Title</PageTitle>

<div class="archive">
    <header class="bar">
        <RadzenButton Icon="arrow_back" Text="@Strings.Nav_BackToBoard" Size="ButtonSize.Small"
                      ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="BackToBoard" />
        <span class="title">@Strings.Archive_Title</span>

        @if (board.HasArchived)
        {
            <CardFilter @bind-Query="query" Placeholder="@Strings.Search_Placeholder" />
        }

        @* Also a dialog: this is the one irreversible action in the app, so it must not be quieter
           than the reversible one next to it. It is gone while a filter is up: *Clear archive*
           empties what the list shows, and a filtered list is not what it would empty. *@
        <div class="purge">
            @if (board.HasArchived && !Filtering)
            {
                <RadzenButton Icon="delete_forever" Text="@Strings.Archive_Clear" Size="ButtonSize.ExtraSmall"
                              ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Disabled="purging"
                              Click="PurgeAsync" />
            }
        </div>
    </header>

    <div class="body">
        <div class="sheet">
            @if (!board.HasArchived)
            {
                <RadzenText TextStyle="TextStyle.Body2" Text="@Strings.Archive_Empty" class="empty" />
            }
            else if (Rows.Count == 0)
            {
                <RadzenText TextStyle="TextStyle.Body2" Text="@Strings.Archive_NoMatch" class="empty" />
            }
            else
            {
                @foreach (var card in Rows)
                {
                    <div class="row">
                        <span class="id">#@card.Number</span>
                        @* A link rather than a click handler: an archived card is a route like any
                           other, so it gets the middle-click, the keyboard and the hover target the
                           browser already knows how to give it. What it opens is read-only
                           throughout — see `TaskEditing`. *@
                        <a class="what" href="@CardTabs.Route(card.Id, CardSurface.Task)"
                           title="@Strings.Archive_Open">
                            <span class="ttl">@CardTitle.Of(card)</span>
                            <span class="meta">@Meta(card)</span>
                        </a>
                        <RadzenButton Icon="restore_from_trash" Size="ButtonSize.ExtraSmall"
                                      ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined"
                                      Click="@(() => RestoreAsync(card))"
                                      title="@Strings.Archive_Restore" aria-label="@Strings.Archive_Restore" />
                        @* Restoring puts the old run back; duplicating starts the same task over,
                           which is the other reason to come looking for an archived card. *@
                        <RadzenButton Icon="content_copy" Size="ButtonSize.ExtraSmall"
                                      ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined"
                                      Disabled="duplicating" Click="@(() => DuplicateAsync(card))"
                                      title="@Strings.Archive_Duplicate" aria-label="@Strings.Archive_Duplicate" />
                    </div>
                }
            }
        </div>
    </div>
</div>
