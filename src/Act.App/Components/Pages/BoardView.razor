@page "/"
@using Act.Core.Model

<PageTitle>@($"ACT — {Strings.Shell_FullName}")</PageTitle>

<div class="board @DensityClass @(dragging is null ? null : "dragging")">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Stretch" Gap="0.6rem" class="cols">
        @foreach (var column in AllColumns)
        {
            var cards = CardsIn(column);

            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" class="@ColumnClass(column)"
                         @ondragover:preventDefault="true" @ondragenter:preventDefault="true"
                         @ondrop="() => DropAsync(column)">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.45rem">
                    <RadzenText TextStyle="TextStyle.Subtitle2" Text="@Label(column)" class="colname" />
                    <RadzenBadge Variant="Variant.Outlined" BadgeStyle="BadgeStyle.Base" IsPill="true"
                                 Text="@cards.Count.ToString()" class="colcount" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                    @if (cards.Count == 0)
                    {
                        <RadzenText TextStyle="TextStyle.Caption" Text="@Strings.Board_ColumnEmpty" class="empty" />
                    }
                    else
                    {
                        foreach (var card in cards)
                        {
                            <FlightStrip Card="card" Density="Density" OnOpen="OpenAsync" OnLaunch="LaunchAsync"
                                         OnDragStart="OnDragStartAsync" OnDragEnd="OnDragEndAsync"
                                         IsDragging="dragging?.Id == card.Id" IsLaunching="IsLaunching(card)" />
                        }
                    }
                </RadzenStack>
            </RadzenStack>
        }
    </RadzenStack>
</div>
