@using Act.Core.Abstractions

<div class="picker">
    <div class="crumbs">
        <RadzenButton Icon="home" Text="@Strings.Picker_Home" Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" ButtonType="ButtonType.Button"
                      Click="@(() => OpenAsync(directories.Home))" />
        <RadzenButton Icon="storage" Text="@Strings.Picker_Roots" Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" ButtonType="ButtonType.Button"
                      Click="@(() => OpenAsync(null))" />
        <RadzenButton Icon="arrow_upward" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Base"
                      Variant="Variant.Text" ButtonType="ButtonType.Button" Disabled="@(listing.Parent is null)"
                      Click="@(() => OpenAsync(listing.Parent))" title="@Strings.Picker_Up" />
        <span class="here">@(listing.Path ?? Strings.Picker_Roots)</span>
    </div>

    <div class="entries">
        @if (listing.Error is { } error)
        {
            <RadzenText TextStyle="TextStyle.Caption" Text="@ErrorText(error)" class="pickererr" />
        }
        else if (listing.Directories.Count == 0)
        {
            <RadzenText TextStyle="TextStyle.Caption" Text="@Strings.Picker_Empty" class="pickerhint" />
        }
        else
        {
            @foreach (var entry in listing.Directories)
            {
                <button type="button" class="entry" @onclick="@(() => OpenAsync(entry.Path))">
                    <RadzenIcon Icon="folder" />
                    <span>@entry.Name</span>
                </button>
            }
        }
    </div>

    <div class="pickeractions">
        <RadzenButton Text="@Strings.Picker_Cancel" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Base"
                      Variant="Variant.Text" ButtonType="ButtonType.Button" Click="CancelAsync" />
        <RadzenButton Text="@Strings.Picker_Use" Icon="check" Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Button"
                      Disabled="@(listing.Path is null)" Click="ChooseAsync" />
    </div>
</div>
