<!DOCTYPE html>
@* On the document element, not the layout root: Radzen mounts a dialog's mask and wrapper at
   <body>, outside the layout, and the `--act-*` tokens — plus the `--rz-*` overrides written in
   terms of them — have to reach there too. (Dropdown panels turned out to render inline, so this
   is about dialogs.) Rendered here for the first paint; `actTheme.apply` keeps it current. *@
<html lang="@Language" data-act-theme="@Theme">

<head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <ThemeStylesheets />
    <link rel="stylesheet" href="@(Assets["app.css"] + AssetVersion)" />
    <link rel="stylesheet" href="@(Assets["Act.App.styles.css"] + AssetVersion)" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png@(AssetVersion)" />
    @* Interactive on purpose: a statically-rendered outlet is written once by the server and never
       hears from the circuit again, so every <PageTitle> after the first navigation is ignored. *@
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@(Assets["_content/Radzen.Blazor/Radzen.Blazor.js"] + RadzenAssetVersion)"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
