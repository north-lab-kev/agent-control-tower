@inherits LayoutComponentBase

<div class="act-root" data-act-theme="@ThemeAttribute">
    <RadzenComponents />

    <div class="shell">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" class="bar">
            <RadzenText TextStyle="TextStyle.H6" Text="ACT" class="wordmark" />

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.6rem">
                <RadzenBadge Variant="Variant.Outlined" BadgeStyle="BadgeStyle.Base"
                             Text="auto-exec on" class="statchip live" />
                <RadzenBadge Variant="Variant.Outlined" BadgeStyle="BadgeStyle.Base"
                             Text="☕ awake" class="statchip" />

                <RadzenSelectBar @bind-Value="Density" TValue="BoardDensity" Size="ButtonSize.ExtraSmall">
                    <Items>
                        <RadzenSelectBarItem Text="Compact" Value="BoardDensity.Compact" />
                        <RadzenSelectBarItem Text="Spacious" Value="BoardDensity.Spacious" />
                    </Items>
                </RadzenSelectBar>

                <RadzenButton Icon="settings" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                              Size="ButtonSize.Small" Click="OpenSettingsAsync" class="gear"
                              title="Settings" aria-label="Settings" />

                @if (AttentionCount > 0)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Warning" IsPill="true"
                                 Text="@($"{AttentionCount} NEED YOU ›")" class="needpill" />
                }
            </RadzenStack>
        </RadzenStack>

        <main>
            <CascadingValue Value="Density" Name="Density">
                @Body
            </CascadingValue>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
