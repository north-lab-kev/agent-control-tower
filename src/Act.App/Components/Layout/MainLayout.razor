@inherits LayoutComponentBase
@using Act.Core.Model

<RadzenComponents />

<div class="shell">
    <div class="bar">
        <span class="wordmark">ACT</span>

        <span class="spacer"></span>

        <span class="chip"><span class="g"></span>auto-exec on</span>
        <span class="chip">☕ awake</span>

        <div class="seg">
            <button type="button" class="@(compact ? "on" : null)" @onclick="() => compact = true">Compact</button>
            <button type="button" class="@(compact ? null : "on")" @onclick="() => compact = false">Spacious</button>
        </div>

        @if (AttentionCount > 0)
        {
            <button type="button" class="needpill">
                <span class="pdot"></span>@AttentionCount NEED YOU ›
            </button>
        }
    </div>

    <main>
        <CascadingValue Value="compact" Name="Compact">
            @Body
        </CascadingValue>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool compact = true;

    private static int AttentionCount => SampleBoard.Cards.Count(c => c.NeedsAttention);
}
