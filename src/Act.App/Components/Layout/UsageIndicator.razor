@* Two lines per window, not three: everything you read on one, the bar under it. The strip's height
   is set by its tallest occupant, and the original stacked meter made the whole shell taller than
   the window controls it sits beside. *@
@* Once per render, not once per access: both are derived from the readings and the clock. *@
@{
    var meters = Meters;
    var notices = Notices;
}
@if (meters.Count > 0 || notices.Count > 0)
{
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.9rem" class="usage">
        @foreach (var meter in meters)
        {
            <div class="meter @meter.State" title="@meter.Tooltip">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                             Gap="0.35rem" class="mtop">
                    <RadzenText TextStyle="TextStyle.Caption" Text="@meter.Label" class="mlabel" />
                    <RadzenText TextStyle="TextStyle.Caption" Text="@meter.Value" class="mvalue" />
                    <RadzenText TextStyle="TextStyle.Caption" Text="@meter.Reset" class="mreset" />
                </RadzenStack>

                <RadzenProgressBar Value="@meter.Percent" ShowValue="false"
                                   Mode="ProgressBarMode.Determinate" class="mbar" />
            </div>
        }

        @foreach (var notice in notices)
        {
            <div class="meter warn" title="@notice.Tooltip">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                             Gap="0.35rem" class="mtop">
                    <RadzenText TextStyle="TextStyle.Caption" Text="@notice.Label" class="mlabel" />
                    <RadzenIcon Icon="error_outline" class="nicon" />
                    <RadzenText TextStyle="TextStyle.Caption" Text="@Strings.Usage_Unavailable" class="nvalue" />
                    <RadzenText TextStyle="TextStyle.Caption" Text="@notice.Reason" class="mreset" />
                </RadzenStack>

                <div class="nrule"></div>
            </div>
        }
    </RadzenStack>
}
